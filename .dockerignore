# Файлы, которые не нужно копировать в образ Docker

# Зависимости ставятся внутри образа через npm ci
node_modules

# Логи и отладочные файлы
npm-debug.log*
*.log

# Git и настройки редакторов
.git
.gitignore
.vscode
.idea

# Секреты и локальные переменные окружения
.env
.env.*

# Файлы Docker и документация не нужны внутри контейнера
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore
*.md

# Временные файлы
tmp
temp

# Загруженные клиентами файлы (фото, сканы паспортов) не должны попадать
# в образ: в runtime папка подключается volume'ом uploads_data.
# .gitkeep оставляем — он создаёт структуру папок внутри образа,
# и именованный volume при первом монтировании наследует её с правами node.
uploads/*
!uploads/photos
!uploads/passports
uploads/photos/*
!uploads/photos/.gitkeep
uploads/passports/*
!uploads/passports/.gitkeep
