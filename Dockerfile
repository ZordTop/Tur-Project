# Базовый образ: Node.js 20 на Alpine — маленький и быстрый
FROM node:20-alpine

# Рабочая папка внутри контейнера
WORKDIR /app

# Сначала копируем только файлы зависимостей:
# так слой с npm install переиспользуется, пока не изменится package.json
COPY package*.json ./

# Устанавливаем только production-зависимости.
# После первого npm install появится package-lock.json —
# тогда строку можно заменить на "RUN npm ci --omit=dev" (быстрее и строже).
RUN npm install --omit=dev

# Копируем остальной код проекта
COPY . .

# Приложение слушает этот порт
EXPOSE 3000

# Порт можно переопределить через переменную окружения
ENV PORT=3000

# Запуск от непривилегированного пользователя
USER node

CMD ["node", "server.js"]
