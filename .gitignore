# Зависимости
node_modules/

# Логи
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Переменные окружения (секреты не должны попадать в git)
.env
.env.local
!.env.example

# Кэш и системный мусор
.npm
.cache/
.DS_Store
Thumbs.db

# Настройки редакторов
.vscode/
.idea/

# Временные файлы
tmp/
temp/

# Локальный скрипт запуска сайта (удобство разработчика, не часть проекта)
start_site.bat
end_site.bat

# Загруженные пользователями файлы (фото, сканы паспортов) — не в git.
# Структура папок сохраняется через .gitkeep, содержимое игнорируется.
uploads/*
!uploads/photos/
!uploads/passports/
uploads/photos/*
!uploads/photos/.gitkeep
uploads/passports/*
!uploads/passports/.gitkeep


