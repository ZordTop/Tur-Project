<%- include('partials/header') %>

<%
  /* ── Вспомогательные функции (безопасны при отсутствии полей) ── */
  var user = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;

  // Маппинг ENUM-значений БД → человекочитаемые подписи
  var flightClassMap = { economy: 'Эконом', comfort: 'Комфорт', business: 'Бизнес' };
  var mealMap = { RO: 'Без питания', BB: 'Только завтраки', HB: 'Полупансион', AI: 'Всё включено' };
  var transferMap = { bus: 'Общий автобус', private: 'Личный автомобиль' };

  // Русское склонение: plural(7, ['ночь','ночи','ночей']) → 'ночей'
  function plural(n, forms) {
    var abs = Math.abs(n) % 100, last = abs % 10;
    if (abs > 10 && abs < 20) return forms[2];
    if (last > 1 && last < 5) return forms[1];
    if (last === 1) return forms[0];
    return forms[2];
  }

  // Дата: '1 июня 2027'
  function fmt(d) {
    if (!d) return '—';
    try { return new Date(d).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }); }
    catch (_) { return String(d); }
  }

  // Дата + время: '1 июня 2027, 08:30'
  function fmtDateTime(d) {
    if (!d) return '—';
    try { return new Date(d).toLocaleString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }); }
    catch (_) { return String(d); }
  }

  // Разряды цены: 43000 → '43 000'
  function price(v) { var n = Number(v); return isNaN(n) ? String(v) : n.toLocaleString('ru-RU'); }

  // Нормализация пути картинки: 'sochi.jpg' → '/images/sochi.jpg'
  function imgPath(img) {
    if (!img) return null;
    if (img.charAt(0) === '/' || /^https?:\/\//.test(img)) return img;
    return '/images/' + img;
  }

  var imgSrc = imgPath(tour.image);
  var bookAction = '/tours/' + (tour.id != null ? tour.id : (typeof id !== 'undefined' ? id : '')) + '/book';
%>

<section class="section">
  <div class="container">
    <a class="back-link" href="/tours">← Все туры</a>

    <% /* Ошибки от бэкенда (например, после неудачного бронирования) */ %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert--error" role="alert" style="margin-bottom:20px;"><%= error %></div>
    <% } %>

    <!-- ═══ 1. Заголовок, фото, рейтинг, описание ═══ -->
    <article class="tour">
      <div class="card__image tour__image<%= imgSrc ? '' : ' card__image--empty' %>">
        <% if (imgSrc) { %>
          <img src="<%= imgSrc %>" alt="<%= tour.title %>"
               onerror="this.closest('.tour__image').classList.add('card__image--empty'); this.remove();">
        <% } %>
      </div>

      <div class="tour__content">
        <div class="tour-hero__meta">
          <% if (tour.destination_country) { %><span><%= tour.destination_country %></span><% } %>
          <% if (tour.destination_city) { %><span>· <%= tour.destination_city %></span><% } %>
          <% if (tour.rating) { %><span class="tour-hero__rating">★ <%= Number(tour.rating).toFixed(1) %></span><% } %>
        </div>

        <h1 class="page-title"><%= tour.title %></h1>

        <% if (tour.description) { %>
          <p class="tour-hero__desc"><%= tour.description %></p>
        <% } %>

        <div class="tour-facts">
          <% if (tour.nights) { %>
            <span class="tour-fact">🌙 <%= tour.nights %> <%= plural(Number(tour.nights), ['ночь', 'ночи', 'ночей']) %></span>
          <% } %>
          <% if (tour.hotel_stars) { %>
            <span class="tour-fact">🏨 <%= '★'.repeat(Number(tour.hotel_stars)) %></span>
          <% } %>
          <% if (tour.hotel_meal) { %>
            <span class="tour-fact">🍽 <%= mealMap[tour.hotel_meal] || tour.hotel_meal %></span>
          <% } %>
          <% if (tour.flight_class) { %>
            <span class="tour-fact">✈ <%= flightClassMap[tour.flight_class] || tour.flight_class %> класс</span>
          <% } %>
        </div>

        <div class="tour-hero__price-row">
          <div>
            <span class="tour-hero__price-label">Стоимость пакета на одного человека</span>
            <span class="tour__price"><%= price(tour.total_price) %> ₽</span>
          </div>
          <div class="tour-hero__actions">
            <a class="btn btn--primary" href="#booking">Забронировать</a>
          </div>
        </div>
      </div>
    </article>

    <!-- ═══ 2. Детализация пакета: перелёт / проживание / трансфер ═══ -->
    <h2 class="section__title" style="margin-top:44px;">Что входит в стоимость</h2>

    <div class="package">
      <!-- Блок «Перелёт» -->
      <section class="package-card">
        <header class="package-card__header">
          <span class="package-card__icon package-card__icon--flight">✈️</span>
          <div>
            <h3 class="package-card__title">Перелёт</h3>
            <p class="package-card__subtitle">Авиабилеты в обе стороны</p>
          </div>
        </header>

        <div class="package-card__body">
          <div class="package-card__route">
            <span><%= tour.departure_city || '—' %></span>
            <span class="package-card__arrow">→</span>
            <span><%= tour.destination_city || '—' %></span>
          </div>

          <dl class="package-list">
            <% if (tour.departure_at) { %>
              <div class="package-list__row">
                <dt class="package-list__label">Туда</dt>
                <dd class="package-list__value"><%= fmtDateTime(tour.departure_at) %></dd>
              </div>
            <% } %>
            <% if (tour.arrival_at) { %>
              <div class="package-list__row">
                <dt class="package-list__label">Прилёт</dt>
                <dd class="package-list__value"><%= fmtDateTime(tour.arrival_at) %></dd>
              </div>
            <% } %>
            <% if (tour.flight_duration) { %>
              <div class="package-list__row">
                <dt class="package-list__label">В пути</dt>
                <dd class="package-list__value"><%= tour.flight_duration %></dd>
              </div>
            <% } %>
            <div class="package-list__row">
              <dt class="package-list__label">Класс</dt>
              <dd class="package-list__value">
                <span class="badge badge--class"><%= flightClassMap[tour.flight_class] || tour.flight_class || '—' %></span>
              </dd>
            </div>
          </dl>
        </div>

        <footer class="package-card__footer">
          <span class="package-card__price-label">Перелёт</span>
          <span class="package-card__price"><%= price(tour.flight_price) %> ₽</span>
        </footer>
      </section>

      <!-- Блок «Проживание» -->
      <section class="package-card">
        <header class="package-card__header">
          <span class="package-card__icon package-card__icon--hotel">🏨</span>
          <div>
            <h3 class="package-card__title">Проживание</h3>
            <p class="package-card__subtitle"><%= tour.hotel_name || 'Отель' %></p>
          </div>
        </header>

        <div class="package-card__body">
          <div class="package-card__route">
            <span><%= tour.destination_city || '—' %></span>
            <span class="package-card__arrow">·</span>
            <span><%= tour.destination_country || '—' %></span>
          </div>

          <dl class="package-list">
            <div class="package-list__row">
              <dt class="package-list__label">Отель</dt>
              <dd class="package-list__value">
                <%= tour.hotel_name || '—' %>
                <% if (tour.hotel_stars) { %>
                  <span class="badge badge--stars"><%= '★'.repeat(Number(tour.hotel_stars)) %></span>
                <% } %>
              </dd>
            </div>
            <div class="package-list__row">
              <dt class="package-list__label">Питание</dt>
              <dd class="package-list__value">
                <span class="badge badge--meal"><%= mealMap[tour.hotel_meal] || tour.hotel_meal || '—' %></span>
              </dd>
            </div>
            <% if (tour.nights) { %>
              <div class="package-list__row">
                <dt class="package-list__label">Проживание</dt>
                <dd class="package-list__value"><%= tour.nights %> <%= plural(Number(tour.nights), ['ночь', 'ночи', 'ночей']) %></dd>
              </div>
            <% } %>
            <% if (tour.departure_at) { %>
              <div class="package-list__row">
                <dt class="package-list__label">Заезд</dt>
                <dd class="package-list__value"><%= fmt(tour.departure_at) %></dd>
              </div>
            <% } %>
          </dl>
        </div>

        <footer class="package-card__footer">
          <span class="package-card__price-label">Проживание</span>
          <span class="package-card__price"><%= price(tour.hotel_price) %> ₽</span>
        </footer>
      </section>

      <!-- Блок «Трансфер» -->
      <section class="package-card">
        <header class="package-card__header">
          <span class="package-card__icon package-card__icon--transfer">🚐</span>
          <div>
            <h3 class="package-card__title">Трансфер</h3>
            <p class="package-card__subtitle">Аэропорт ↔ отель</p>
          </div>
        </header>

        <div class="package-card__body">
          <dl class="package-list">
            <div class="package-list__row">
              <dt class="package-list__label">Тип</dt>
              <dd class="package-list__value">
                <span class="badge badge--transfer"><%= transferMap[tour.transfer_type] || tour.transfer_type || '—' %></span>
              </dd>
            </div>
            <div class="package-list__row">
              <dt class="package-list__label">Маршрут</dt>
              <dd class="package-list__value">Аэропорт → отель → аэропорт</dd>
            </div>
            <div class="package-list__row">
              <dt class="package-list__label">Включено</dt>
              <dd class="package-list__value">Туда и обратно</dd>
            </div>
          </dl>
        </div>

        <footer class="package-card__footer">
          <span class="package-card__price-label">Трансфер</span>
          <span class="package-card__price"><%= price(tour.transfer_price) %> ₽</span>
        </footer>
      </section>
    </div>

    <!-- ═══ 3. Итоговая стоимость ═══ -->
    <div class="total-block">
      <div>
        <p class="total-block__label">Итого за пакет на одного человека</p>
        <p class="total-block__sum"><%= price(tour.total_price) %> ₽</p>
        <p class="total-block__hint">Никаких скрытых доплат: рейс, отель и трансфер уже включены.</p>
      </div>

      <div class="total-block__calc">
        <div class="total-chip"><small>Перелёт</small><%= price(tour.flight_price) %> ₽</div>
        <span class="total-block__op">+</span>
        <div class="total-chip"><small>Отель</small><%= price(tour.hotel_price) %> ₽</div>
        <span class="total-block__op">+</span>
        <div class="total-chip"><small>Трансфер</small><%= price(tour.transfer_price) %> ₽</div>
        <div class="total-block__equals"><span>=</span>итог</div>
        <div class="total-chip" style="background:rgba(255,255,255,0.28); font-weight:800;">
          <%= price(tour.total_price) %> ₽
        </div>
      </div>
    </div>

    <!-- ═══ 4. Бронирование ═══ -->
    <section class="booking-section" id="booking">
      <h2 class="booking-section__title">Бронирование</h2>
      <p class="booking-section__subtitle">Оставьте заявку — менеджер свяжется с вами для подтверждения.</p>

      <% if (user) { %>
        <!-- Данные подставляются из профиля (п. 1 контракта: id, email, full_name, phone, role) -->
        <dl class="booking-user">
          <div class="booking-user__item">
            <dt>Турист</dt>
            <dd><%= user.full_name %></dd>
          </div>
          <div class="booking-user__item">
            <dt>Телефон</dt>
            <dd><%= user.phone %></dd>
          </div>
          <div class="booking-user__item">
            <dt>Тур</dt>
            <dd><%= tour.title %></dd>
          </div>
          <div class="booking-user__item">
            <dt>К оплате</dt>
            <dd><%= price(tour.total_price) %> ₽</dd>
          </div>
        </dl>

        <form method="POST" action="/tours/<%= tour.id %>/book?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="form auth-card__form" style="max-width:none;">
          <% // CSRF-токен в query (form enctype="multipart/form-data" блокирует req.body — csrf читает из query) %>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <h3 style="margin: 0 0 12px;">Анкета туриста</h3>

          <div class="form__group">
            <label class="form__label" for="client_name">ФИО туриста <span style="color:var(--clr-danger);">*</span></label>
            <input class="form__input" type="text" id="client_name" name="client_name" value="<%= user.full_name || '' %>" placeholder="Иванов Иван Иванович" autocomplete="name" maxlength="150" required>
          </div>

          <div class="form__group">
            <label class="form__label" for="client_phone">Телефон <span style="color:var(--clr-danger);">*</span></label>
            <input class="form__input" type="tel" id="client_phone" name="client_phone" value="<%= user.phone || '' %>" placeholder="79001234567" inputmode="tel" maxlength="11" pattern="[0-9]{11}" required>
            <span class="form__hint">Ровно 11 цифр, без пробелов и скобок</span>
          </div>

          <div class="form__group">
            <label class="form__label" for="birth_date">Дата рождения <span style="color:var(--clr-danger);">*</span></label>
            <input class="form__input" type="date" id="birth_date" name="birth_date" required>
          </div>

          <div class="form__group">
            <label class="form__label" for="passport_series_number">Серия и номер паспорта <span style="color:var(--clr-danger);">*</span></label>
            <input class="form__input" type="text" id="passport_series_number" name="passport_series_number" placeholder="4510 123456" maxlength="11" pattern="[0-9]{10}" required>
            <span class="form__hint">Ровно 10 цифр (4 цифры серии + 6 цифр номера)</span>
          </div>

          <div class="form__group">
            <label class="form__label" for="passport_issued_by">Кем выдан паспорт <span style="color:var(--clr-danger);">*</span></label>
            <input class="form__input" type="text" id="passport_issued_by" name="passport_issued_by" placeholder="Отделом УФМС г. Москвы по району…" maxlength="255" required>
          </div>

          <div class="form__group">
            <label class="form__label" for="passport_expires_at">Срок действия паспорта <span style="color:var(--clr-danger);">*</span></label>
            <input class="form__input" type="date" id="passport_expires_at" name="passport_expires_at" required>
          </div>

          <div class="form__group">
            <label class="form__label" for="client_photo">Фотография туриста</label>
            <input class="form__input" type="file" id="client_photo" name="client_photo" accept="image/jpeg,image/png,image/webp">
            <span class="form__hint">JPG, PNG или WEBP, до 5 МБ. Мини-превью появится сразу после выбора.</span>
            <div id="preview_client_photo" class="file-preview" style="margin-top:8px;"></div>
          </div>

          <div class="form__group">
            <label class="form__label" for="passport_scan">Ксерокс / скан паспорта</label>
            <input class="form__input" type="file" id="passport_scan" name="passport_scan" accept="image/jpeg,image/png,image/webp">
            <span class="form__hint">JPG, PNG или WEBP, до 5 МБ.</span>
            <div id="preview_passport_scan" class="file-preview" style="margin-top:8px;"></div>
          </div>

          <div class="form__group">
            <label class="form__label" for="comment">Комментарий к заявке</label>
            <textarea
              class="form__input form__textarea"
              id="comment"
              name="comment"
              rows="4"
              maxlength="1000"
              placeholder="Пожелания к туру: номер для некурящих, детский кроватка, трансфер к раннему рейсу…"
            ></textarea>
          </div>

          <div class="booking-form__actions">
            <button class="btn btn--primary btn--lg" type="submit">Забронировать</button>
            <span class="booking-note">Нажимая кнопку, вы соглашаетесь на обработку персональных данных.</span>
          </div>
        </form>
      <% } else { %>
        <div class="booking-guest">
          <p class="booking-guest__text">
            Чтобы забронировать тур, <a href="/login">войдите</a> в аккаунт или
            <a href="/register">зарегистрируйтесь</a> — это займёт минуту.
          </p>
          <a class="btn btn--primary" href="/login">Войдите, чтобы забронировать</a>
        </div>
      <% } %>
    </section>
  </div>
</section>

<%- include('partials/footer') %>
