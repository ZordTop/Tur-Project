<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script>
    (function(){var t=localStorage.getItem('tur_theme');if(!t)t=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';document.documentElement.setAttribute('data-theme',t);})();
  </script>
  <title><%= typeof title !== 'undefined' ? title : 'Туристический сайт' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<%
  // Класс роли на <body> для визуального разделения интерфейсов:
  // витрина клиента, терминал менеджера и админ-панель выглядят по-разному
  const _role = (typeof currentUser !== 'undefined' && currentUser) ? currentUser.role : 'guest';
%>
<body class="role-<%= _role %>">
  <header class="header">
    <div class="container header__inner">
      <a class="logo" href="/">
        <span class="logo__mark">Т</span>
        <span class="logo__text">ТурПроект</span>
      </a>

      <button class="burger" type="button" aria-label="Открыть меню" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <nav class="nav" id="nav">
        <!-- Основные ссылки (всегда) -->
        <a class="nav__link" href="/">Главная</a>
        <a class="nav__link" href="/tours">Туры</a>
        <a class="nav__link" href="/about">О нас</a>

        <%# CRM-база туристов: только сотрудники (менеджер и админ) %>
        <% if (typeof currentUser !== 'undefined' && currentUser && (currentUser.role === 'manager' || currentUser.role === 'admin')) { %>
          <a class="nav__link" href="/clients">База туристов</a>
        <% } %>


        <% if (typeof currentUser === 'undefined' || !currentUser) { %>
          <!-- Гость: Войти + Регистрация -->
          <div class="nav__actions">
            <a class="btn btn--sm btn--secondary" href="/login">Войти</a>
            <a class="btn btn--sm btn--primary" href="/register">Регистрация</a>
            <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Переключить тему">
              <svg class="theme-toggle__icon--sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              <svg class="theme-toggle__icon--moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>
          </div>

        <% } else if (currentUser.role === 'user') { %>
          <!-- Клиент: Мои брони + имя + Выйти -->
          <a class="nav__link" href="/profile">Мои брони</a>
          <div class="nav__actions">
            <div class="user-menu">
              <span class="user-menu__avatar"><%= currentUser.full_name.charAt(0) %></span>
              <span class="user-menu__name"><%= currentUser.full_name %></span>
            </div>
            <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Переключить тему">
              <svg class="theme-toggle__icon--sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              <svg class="theme-toggle__icon--moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>
            <form method="post" action="/logout">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button class="btn btn--sm btn--danger" type="submit">Выйти</button>
            </form>
          </div>

        <% } else if (currentUser.role === 'manager') { %>
          <!-- Менеджер: Кабинет менеджера + Выйти -->
          <div class="nav__actions">
            <a class="btn btn--sm btn--accent" href="/manager">Кабинет менеджера</a>
            <div class="user-menu">
              <span class="user-menu__avatar"><%= currentUser.full_name.charAt(0) %></span>
              <span class="user-menu__name"><%= currentUser.full_name %></span>
            </div>
            <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Переключить тему">
              <svg class="theme-toggle__icon--sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              <svg class="theme-toggle__icon--moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>
            <form method="post" action="/logout">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button class="btn btn--sm btn--danger" type="submit">Выйти</button>
            </form>
          </div>

        <% } else if (currentUser.role === 'admin') { %>
          <!-- Админ: Админ-панель + Кабинет менеджера + Выйти -->
          <div class="nav__actions">
            <a class="btn btn--sm btn--primary" href="/admin">Админ-панель</a>
            <a class="btn btn--sm btn--accent" href="/manager">Кабинет менеджера</a>
            <div class="user-menu">
              <span class="user-menu__avatar"><%= currentUser.full_name.charAt(0) %></span>
              <span class="user-menu__name"><%= currentUser.full_name %></span>
            </div>
            <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Переключить тему">
              <svg class="theme-toggle__icon--sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              <svg class="theme-toggle__icon--moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </button>
            <form method="post" action="/logout">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button class="btn btn--sm btn--danger" type="submit">Выйти</button>
            </form>
          </div>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="main">
<%
  // Одноразовые flash-сообщения (success/error/info) после redirect.
  // Кладёт их middleware flash.js в res.locals.flash.
  const _flash = (typeof flash !== 'undefined' && Array.isArray(flash)) ? flash : [];
%>
<% if (_flash.length > 0) { %>
  <div class="container" style="margin-top:20px;">
    <% _flash.forEach(function (msg) { %>
      <div class="alert alert--<%= msg.type === 'error' ? 'error' : msg.type === 'success' ? 'success' : 'info' %>" role="<%= msg.type === 'error' ? 'alert' : 'status' %>" style="margin-bottom:12px;">
        <%= msg.message %>
      </div>
    <% }); %>
  </div>
<% } %>
