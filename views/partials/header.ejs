<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Туристический сайт' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="header">
    <div class="container header__inner">
      <a class="logo" href="/">
        <span class="logo__mark">Т</span>
        <span class="logo__text">ТурПроект</span>
      </a>

      <button class="burger" type="button" aria-label="Открыть меню" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <nav class="nav" id="nav">
        <a class="nav__link" href="/">Главная</a>
        <a class="nav__link" href="/tours">Туры</a>
        <a class="nav__link" href="/about">О нас</a>

        <div class="nav__auth">
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <span class="nav__auth__name"><%= currentUser.full_name %></span>
            <!-- Личный кабинет доступен любой роли: заявка создаётся от своего user_id -->
            <a class="nav__link nav__link--auth" href="/profile">Мои заявки</a>
            <% if (currentUser.role === 'admin') { %>
              <a class="nav__link nav__link--auth" href="/admin">Админка</a>
            <% } %>
            <% if (currentUser.role === 'manager' || currentUser.role === 'admin') { %>
              <a class="nav__link nav__link--auth" href="/manager">Кабинет</a>
            <% } %>
            <form method="post" action="/auth/logout" class="nav__auth__form">
              <button class="nav__link nav__link--auth" type="submit">Выход</button>
            </form>
          <% } else { %>
            <a class="nav__link nav__link--auth" href="/login">Вход</a>
            <a class="btn btn--primary btn--sm" href="/register">Регистрация</a>
          <% } %>
        </div>
      </nav>
    </div>
  </header>

  <main class="main">
